{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "docs": {
        "type": "local",
        "command": ["node", "./mcp/docs-server.mjs"],
        "description": "Search the internal documentation index from the agent."
      }
    }
  },
  "tools": {
    "search_docs": {
      "description": "Search docs by keyword and return matching sections.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "limit": { "type": "number" }
        },
        "required": ["query"]
      }
    }
  }
}
